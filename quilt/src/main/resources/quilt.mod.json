{
  "schema_version": 1,
  "mixin": [
    "keywizard.mixins.json",
    "keywizard-common.mixins.json"
  ],
  "quilt_loader": {
    "group": "${group}",
    "id": "keywizard",
    "version": "${version}",
    "metadata": {
      "name": "Keywizard Mod",
      "description": "Keyboard Wizard is simple that makes finding and fixing key bind conflicts a lot easier.\nThanks to MrNerdy42.",
      "contributors": {
        "CC": "Owner",
        "Flechazo": "Contributors"
      },
      "contact": {
        "sources": "https://github.com/mylxiaoyi/minecraft-keywizard",
        "fork": "https://github.com/Flechazo098/minecraft-keywizard"
      },
      "icon": "assets/icon.png"
    },
    "intermediate_mappings": "net.fabricmc:intermediary",
    "entrypoints": {
      "client_init": [
        "xyz.xindi.keywizard.quilt.KeyWizardQuilt"
      ]
    },
    "depends": [
      {
        "id": "quilt_loader",
        "version": "*"
      },
      {
        "id": "quilt_base",
        "version": "*"
      },
      {
        "id": "minecraft",
        "version": ">=1.20.1"
      },
      {
        "id": "architectury",
        "version": ">=9.1.12"
      }
    ]
  },
  "minecraft": {
    "environment": "client"
  }
}